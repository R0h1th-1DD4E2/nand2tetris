// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    
    PARTS:
    Inc16(in=regout , out=incre );
    Mux16(a=regout , b=incre , sel=inc , out=incout );
    Mux16(a=incout , b=in , sel=load , out=loadout );
    Mux16(a=loadout , b=false , sel=reset , out=reout );
    Or(a=load, b=reset, out=loorre);
	Or(a=loorre, b=inc, out=loadflag);
    Register(in=reout , load=loadflag , out=regout );
    And16(a=regout , b=regout , out=out );
}